# ============================================================
# Lá Chắn Số - Backend environment
# Copy file này thành `.env` trên server Vietnix rồi điền giá trị.
# KHÔNG bao giờ commit file .env thật lên git.
# ============================================================

# --- Cổng bảo mật giữa Vercel proxy và backend (BẮT BUỘC) ---
# Tạo bằng:  openssl rand -hex 32
# Phải GIỐNG HỆT giá trị LCS_BACKEND_SECRET set trên Vercel Project Env Vars.
LCS_BACKEND_SECRET=thay-bang-64-ky-tu-hex-ngau-nhien

# --- Host IP/domain backend để Vercel gọi tới ---
# Tạm thời (không domain): http://42.1.112.100:3001
# Khi có domain: https://api.lachansovn.vn
# (Biến này chỉ set trên Vercel, không cần ở đây — để tham khảo)

# --- CORS: domain frontend deploy ---
# Nếu frontend chạy ở domain khác (vd lachansovn.vn), set URL này.
APP_ORIGIN=https://lachansovn.vercel.app

# --- Port backend ---
PORT=3001

# --- Key API kiểm chứng (giữ server-side, không lộ ra client) ---
VITE_NEWS_API_KEY=
VITE_GOOGLE_FACT_CHECK_API_KEY=

# --- Google Custom Search Engine (tìm kiếm báo chí tiếng Việt) ---
# Nếu để trống, hệ thống tự fallback sang scrape VnExpress/Dân Trí/VietnamNet/Tuổi Trẻ.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# --- Custom Gemini (PRIMARY — OpenAI-compatible, unlimited tokens) ---
# Provider chính trong hệ thống multi-provider chain.
# Endpoint: https://ai.aashutoshjoshi.com/v1
CUSTOM_GEMINI_API_KEY=
CUSTOM_GEMINI_BASE_URL=https://ai.aashutoshjoshi.com/v1
CUSTOM_GEMINI_MODEL=gemini-2.0-flash

# --- DeepSeek V4 (AI đối chiếu báo chí). Để trống = chế độ heuristic fallback ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Ollama local (chỉ khi chạy trên máy có Ollama) ---
# Trên Vietnix không cài Ollama thì để trống, hệ thống dùng DeepSeek cloud.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# OLLAMA_COMPARE_MODEL=
# OLLAMA_FORCE_CPU=true

# --- OpenRouter free (AI tóm tắt + phân loại nội dung web - tiêu chí c9) ---
# Lấy key tại https://openrouter.ai/keys. Đặt ở đây hoặc trên Vercel Project Env Vars.
OPENROUTER_API_KEY=
# Mặc định là NVIDIA Nemotron 3 Ultra free (tốt tiếng Việt, miễn phí).
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free

# --- Groq free (fallback LLM) ---
# Lấy key tại https://console.groq.com/keys
GROQ_API_KEY=

# --- Gemini (fallback LLM) — hỗ trợ tối đa 3 key, chia tải round-robin ---
GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
